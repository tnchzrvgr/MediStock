APP_NAME=MediStock
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

# database made by the .sql files in phpMyAdmin (XAMPP: user root, no password)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medistock
DB_USERNAME=root
DB_PASSWORD=

# we keep the session in files so no extra table is needed
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FACE_LOGIN=true
